{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.taoensso/trove {:mvn/version "1.2.0"}
        ch.obermuhlner/big-math {:mvn/version "2.3.2"}    ; BigDecimal exp/log/root (MIT)
        org.clojure/data.json {:mvn/version "2.5.1"}      ; parse the FRED / CurrencyFreaks JSON
        org.clojure/core.memoize {:mvn/version "1.1.266"} ; TTL cache for live currency rates
        http-kit/http-kit {:mvn/version "2.8.0"}}         ; HTTP client for the live CPI / currency sources
 :aliases
 {:test
  {:extra-paths ["test" "dev"]        ; "dev" so the drift test can load the converter + manifest
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}
  ;; Code coverage (dev-only). Combined with :test on the classpath; instruments only `src`
  ;; (dev/ tooling excluded by path) and skips the generated + live-fetch namespaces — see the
  ;; `coverage` task in build.clj. Run: clojure -X:build coverage
  :coverage
  {:extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}}
  ;; Opt-in Frink oracle (dev/CI only). Frink is proprietary and NOT redistributed — provide the jar
  ;; via a local path (default ../frink.jar) or FRINK_JAR. Combine with :test, e.g.
  ;;   clojure -M:test:frink -m cognitect.test-runner
  ;; The oracle namespace loads fine without it (it resolves the class reflectively); its tests
  ;; self-skip when Frink is absent, so the default suite is unaffected.
  :frink
  {:extra-deps {us.futureboy/frink {:local/root "../frink.jar"}}}
  ;; invoked with -X:build (not -T), so it inherits the root :deps — big-math (used
  ;; by the converter's nth-root) is declared once, up top, and need not be repeated.
  :build {:extra-paths ["." "dev"]    ; "." for build.clj (‑X, unlike ‑T, won't add it); dev-only, NOT jarred
          :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       slipset/deps-deploy {:mvn/version "0.2.5"}
                       org.jsoup/jsoup {:mvn/version "1.18.3"}}       ; CPI (dev): parse Frink's FRED HTML backup
          :ns-default build}}}
